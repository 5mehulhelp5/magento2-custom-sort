<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_save_after">
        <observer name="perspective_loyalty_order_complete_accrual"
                  instance="Perspective\LoyaltyEngine\Observer\OrderCompleteAccrualObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="perspective_loyalty_order_place_redemption"
                  instance="Perspective\LoyaltyEngine\Observer\OrderPlaceRedemptionObserver"/>
    </event>
    <event name="sales_model_service_quote_submit_before">
        <observer name="perspective_loyalty_quote_submit_before"
                  instance="Perspective\LoyaltyEngine\Observer\QuoteSubmitBeforeObserver"/>
    </event>
</config>
